{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "File dialogs, and reading or writing only the files the user picks in them.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-read-file",
    "fs:allow-write-text-file"
  ]
}
