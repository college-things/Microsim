{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Microsim",
  "version": "0.9.1",
  "identifier": "app.microsim.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Microsim",
        "width": 1320,
        "height": 840,
        "minWidth": 900,
        "minHeight": 560,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; worker-src 'self' blob:; connect-src 'self' ipc: http: https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.3",
      "signingIdentity": "-"
    },
    "publisher": "Microsim contributors",
    "copyright": "Copyright (c) 2026 Microsim contributors. MIT License.",
    "license": "MIT",
    "shortDescription": "Lightweight circuit simulator",
    "longDescription": "Microsim is a lightweight circuit simulator: draw a schematic, run analog, digital and microcontroller simulations, and read results on virtual instruments. It opens Multisim .ms14 circuits.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "linux": {
      "deb": {
        "section": "electronics"
      }
    }
  }
}