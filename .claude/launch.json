{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "ohmlet",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "ohmlet-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "preview",
        "--",
        "--base",
        "/Ohmlet/"
      ],
      "port": 4173
    },
    {
      "name": "site",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4180",
        "--directory",
        "dist-site"
      ],
      "port": 4180
    }
  ]
}