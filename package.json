{
  "name": "microsim",
  "version": "0.9.2",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "design:bridge": "node scripts/design-bridge.mjs",
    "test:bridge": "node --test scripts/design-bridge.node.mjs scripts/ni-database.node.mjs scripts/labview-session.node.mjs scripts/toolchain.node.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:web": "tsc --noEmit && vite build --mode web",
    "build:site": "npm run build:web && node scripts/build-site.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --testTimeout=60000",
    "tauri": "tauri"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.4.0",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.4",
    "@tauri-apps/plugin-fs": "2.7.1",
    "mdb-reader": "3.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "22.20.5",
    "typescript": "5.6.3",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
